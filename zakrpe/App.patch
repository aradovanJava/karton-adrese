function AccessBadge({ state }: { state?: AccessState }) {
  if (!state) return null;
  const variant =
    state === "nema podatka" ? "unknown" : state === "djelomično" ? "partial" : state;
  return (
    <span className={cx("access-state", `access-${variant}`)}>
      <Accessibility size={13} aria-hidden="true" />
      {accessLabel[state]}
    </span>
  );
}

function PersonalPanel({
  profile,
  faculty,
  onFaculty,
  interests,
  onInterest,
  needs,
  onNeed,
}: {
  profile: Profile;
  faculty: string;
  onFaculty: (id: string) => void;
  interests: Interest[];
  onInterest: (value: Interest) => void;
  needs: Need[];
  onNeed: (value: Need) => void;
}) {
  if (profile !== "Student" && profile !== "Osoba s invaliditetom") return null;
  const student = profile === "Student";
  const options: string[] = student ? interestOptions : needOptions;
  return (
    <section className="personal-panel" aria-label={student ? "Vaši interesi" : "Vaše potrebe"}>
      <div className="personal-head">
        <strong>
          {student ? "Prilagodite karton svojim interesima" : "Prilagodite karton svojim potrebama"}
        </strong>
        <small>Odabir ostaje samo u poveznici ove stranice — ništa ne spremamo.</small>
      </div>
      {student && (
        <label className="form-field faculty-field">
          Fakultet ili visoko učilište
          <select value={faculty} onChange={(event) => onFaculty(event.target.value)}>
            <option value="">— odaberite —</option>
            {faculties.map((item) => (
              <option key={item.id} value={item.id}>
                {item.name} ({item.address})
              </option>
            ))}
          </select>
        </label>
      )}
      <div className="chip-list" role="group" aria-label={student ? "Interesi" : "Potrebe"}>
        {options.map((option) => {
          const active = student
            ? interests.includes(option as Interest)
            : needs.includes(option as Need);
          return (
            <button
              key={option}
              type="button"
              className={cx("chip", active && "chip-active")}
              aria-pressed={active}
              onClick={() => (student ? onInterest(option as Interest) : onNeed(option as Need))}
            >
              {active && <Check size={15} aria-hidden="true" />}
              {option}
            </button>
          );
        })}
      </div>
    </section>
  );
}

function FacultyRoute({ data, facultyId }: { data: Karton; facultyId: string }) {
  const faculty = faculties.find((item) => item.id === facultyId);
  if (!faculty) {
    return (
      <p className="faculty-route faculty-empty">
        <GraduationCap size={18} aria-hidden="true" /> Odaberite fakultet iznad kako bismo prikazali
        udaljenost i izravne linije ZET-a.
      </p>
    );
  }
  const distance = haversine(data.coordinates, faculty.coordinates);
  const direct = data.transit.lines.filter((line) => faculty.lines.includes(line));
  return (
    <div className="faculty-route">
      <div>
        <small>Do mog fakulteta</small>
        <strong>{faculty.name}</strong>
        <span>
          {faculty.address} · {formatDistance(distance)} zračne udaljenosti
        </span>
      </div>
      <div className="route-lines">
        <TramFront size={18} aria-hidden="true" />
        {direct.length ? (
          <span>
            ZET bez presjedanja: <b>{direct.join(", ")}</b>
          </span>
        ) : (
          <span>Nema izravne linije ZET-a — potrebno je presjedanje.</span>
        )}
      </div>
      <SourceBadge value="Geoportal visokoškolske ustanove · ZET GTFS" />
    </div>
  );
}

function StudentItems({
  data,
  interests,
  onReport,
}: {
  data: Karton;
  interests: Interest[];
  onReport: (object: string, source: string) => void;
}) {
  const items: Array<{ interest: Interest | null; place: Place; detail: string }> = [
    { interest: "Menza", place: data.student.menza, detail: "studentski restoran" },
    { interest: "Knjižnica", place: data.student.library, detail: "narodna knjižnica" },
    { interest: "Bicikl", place: data.student.bikeLane, detail: "najbliža biciklistička staza" },
    {
      interest: "Bicikl",
      place: data.student.publicBike,
      detail: `javni bicikli · ${data.student.publicBike.racks} stalaka`,
    },
    { interest: "Sport", place: data.student.sport, detail: "sportski objekt" },
    { interest: null, place: data.student.housing, detail: "studentsko naselje" },
  ];
  const picked = (item: (typeof items)[number]) =>
    Boolean(item.interest && interests.includes(item.interest));
  const ordered = [...items].sort((a, b) => Number(picked(b)) - Number(picked(a)));
  return (
    <>
      {ordered.map((item) => (
        <DataItem
          key={item.place.name + item.detail}
          name={item.place.name}
          detail={`${formatDistance(item.place.distanceM)} · ${item.detail}`}
          source={item.place.source}
          onReport={onReport}
          muted={interests.length > 0 && !picked(item)}
          badge={
            picked(item) ? (
              <Badge type="interest">Istaknuto jer ste označili: {item.interest}</Badge>
            ) : undefined
          }
        />
      ))}
    </>
  );
}

function PersonalIndex({
  data,
  profile,
  facultyId,
}: {
  data: Karton;
  profile: Profile;
  facultyId: string;
}) {
  const faculty = faculties.find((item) => item.id === facultyId);
  const rows: Array<{ name: string; distanceM: number }> =
    profile === "Obitelj s djecom"
      ? [
          { name: "Dječje igralište", distanceM: data.publicSpaces.playground.distanceM },
          {
            name: "Park",
            distanceM: data.publicSpaces.park.inside ? 0 : data.publicSpaces.park.distanceM,
          },
          { name: "Sportski objekt", distanceM: data.publicSpaces.sport.distanceM },
        ]
      : profile === "Student"
        ? [
            { name: "Menza", distanceM: data.student.menza.distanceM },
            { name: "Knjižnica", distanceM: data.student.library.distanceM },
            { name: "Biciklistička staza", distanceM: data.student.bikeLane.distanceM },
            ...(faculty
              ? [{ name: "Fakultet", distanceM: haversine(data.coordinates, faculty.coordinates) }]
              : []),
          ]
        : [];
  if (!rows.length) return null;
  return (
    <>
      <p className="personal-index-title">Moj indeks · {profile}</p>
      <div className="check-grid">
        {rows.map((item) => {
          const ok = item.distanceM <= THRESHOLD_15_MIN_M;
          return (
            <span className={ok ? "available" : ""} key={item.name}>
              {ok ? <CheckCircle2 /> : <X />}
              {item.name}
              <small>{formatDistance(item.distanceM)}</small>
            </span>
          );
        })}
      </div>
    </>
  );
}

