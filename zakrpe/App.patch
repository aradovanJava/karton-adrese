  const [profile, setProfile] = useState<Profile>(() => {
    const fromUrl = new URLSearchParams(window.location.search).get("profil");
    return profiles.find((item) => item === fromUrl) ?? "Općenito";
  });
  const [data, setData] = useState<Karton | null>(null);
  const initialParams = useMemo(() => new URLSearchParams(window.location.search), []);
  const [faculty, setFaculty] = useState(initialParams.get("fakultet") || "");
  const [interests, setInterests] = useState<Interest[]>(
    (initialParams.get("interesi") || "")
      .split(",")
      .filter((item): item is Interest => interestOptions.includes(item as Interest)),
  );
  const [needs, setNeeds] = useState<Need[]>(
    (initialParams.get("potrebe") || "")
      .split(",")
      .filter((item): item is Need => needOptions.includes(item as Need)),
  );
  const toggle = <T,>(list: T[], value: T) =>
    list.includes(value) ? list.filter((item) => item !== value) : [...list, value];
  // Stanje prikaza čuvamo u poveznici (URL), ne na poslužitelju.
  useEffect(() => {
    const next = new URLSearchParams(window.location.search);
    const set = (key: string, value: string) => (value ? next.set(key, value) : next.delete(key));
    set("profil", profile === "Općenito" ? "" : profile);
    set("fakultet", profile === "Student" ? faculty : "");
    set("interesi", profile === "Student" ? interests.join(",") : "");
    set("potrebe", profile === "Osoba s invaliditetom" ? needs.join(",") : "");
    window.history.replaceState({}, "", `?${next.toString()}${window.location.hash}`);
  }, [profile, faculty, interests, needs]);
